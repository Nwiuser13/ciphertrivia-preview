        <div class="card__body">
          <p class="card__type">Compliance &amp; GRC</p>
          <h3 class="card__title">SOC 2 &amp; ISO 27001 Compliance Checklist</h3>
          <p class="card__text">Organized by what auditors ask for evidence of, not by control numbers.</p>
          <span class="card__go card__go--text">Read Checklist {{ arrow() }}</span>
        </div>
      </a>
      <a class="card rv" style="--d:2" href="/whitepapers/identity-access-management-checklist/">
        <div class="cover cover--ink" aria-hidden="true">{{ icon("user-shield", "cover") }}</div>
        <div class="card__body">
          <p class="card__type">Identity &amp; Access</p>
