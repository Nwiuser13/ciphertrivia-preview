        </div>
      </a>
      <a class="card rv" style="--d:3" href="/whitepapers/devsecops-cicd-security-checklist/">
        <div class="cover cover--ink" aria-hidden="true">{{ icon("pipeline", "cover") }}</div>
        <div class="card__body">
          <p class="card__type">DevSecOps</p>
          <h3 class="card__title">DevSecOps &amp; CI/CD Security Checklist</h3>
          <p class="card__text">Security checks mapped onto your pipeline stages: commit, build, test, package, deploy.</p>
          <span class="card__go card__go--text">Read Checklist {{ arrow() }}</span>
        </div>
      </a>
      <a class="card rv" style="--d:0" href="/whitepapers/incident-response-checklist/">
        <div class="cover cover--signal" aria-hidden="true">{{ icon("alert", "cover") }}</div>
