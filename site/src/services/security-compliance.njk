<!-- WHY CIPHERTRIVIA (second version in the brief)                       -->
<!-- ================================================================== -->
<section class="section section--ink" aria-labelledby="s7-title">
  <div class="container">
    <header class="shead">
      <div class="shead__meta"></div>
      <div class="shead__body">
        <h2 class="shead__title rv" id="s7-title">Why Choose CipherTrivia for Security Compliance Services?</h2>
        <p class="shead__lede rv" style="--d:1">We help organizations navigate complex security requirements through structured compliance assessments and practical remediation guidance. Our security compliance services focus on identifying control gaps and evaluating existing security practices while helping businesses align with relevant industry standards and regulatory frameworks.</p>
      </div>
    </header>

    <div class="principles principles--7">
      <article class="principle rv">
        {{ icon("directory") }}
        <h3 class="principle__title">Expertise Across Compliance Frameworks</h3>
        <p class="principle__text">Our assessments cover ISO 27001, SOC 2, PCI DSS, HIPAA and GDPR, helping organizations understand applicable requirements and evaluate their existing security controls.</p>
      </article>
      <article class="principle rv" style="--d:1">
        {{ icon("gauge") }}
        <h3 class="principle__title">Risk-Based Compliance Assessments</h3>
        <p class="principle__text">We evaluate compliance gaps based on severity and potential business impact so your team can prioritize corrective actions and allocate resources to critical security requirements.</p>
      </article>
      <article class="principle rv" style="--d:2">
        {{ icon("eye") }}
        <h3 class="principle__title">Comprehensive Security Control Reviews</h3>
        <p class="principle__text">Our team examines technical safeguards and organizational policies across access management and data protection alongside vulnerability management and incident response procedures.</p>
      </article>
      <article class="principle rv">
        {{ icon("route") }}
        <h3 class="principle__title">Practical Remediation Recommendations</h3>
        <p class="principle__text">We provide clear findings and actionable guidance to help your team address compliance gaps and improve security controls based on your operational requirements.</p>
      </article>
      <article class="principle rv" style="--d:1">
        {{ icon("present") }}
        <h3 class="principle__title">Structured Documentation and Reporting</h3>
        <p class="principle__text">Our deliverables include compliance gap reports and control mapping documentation alongside supporting evidence requirements to help maintain consistent records for internal reviews and audit preparation.</p>
      </article>
      <article class="principle rv" style="--d:2">
        {{ icon("buildings") }}
        <h3 class="principle__title">Industry-Aligned Compliance Support</h3>
        <p class="principle__text">We consider your business operations and applicable regulatory obligations when assessing compliance requirements, helping align security practices with the standards relevant to your organization.</p>
      </article>
      <article class="principle rv">
        {{ icon("retest") }}
        <h3 class="principle__title">Ongoing Compliance Improvement</h3>
        <p class="principle__text">Our recommendations help organizations review security controls and track corrective actions while adapting compliance practices to changing risks and evolving regulatory requirements.</p>
      </article>
    </div>

    {% include "partials/enterprise/backed.njk" %}
  </div>
</section>

