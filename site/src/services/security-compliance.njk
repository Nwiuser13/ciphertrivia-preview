      <ol class="deliver__list">
        <li class="deliver__item rv">
          {{ icon("document") }}
          <div>
            <h3 class="deliver__title">Compliance Gap Analysis Report</h3>
            <p class="deliver__text">A detailed assessment of existing security controls against applicable framework requirements, highlighting compliance gaps and risk priorities with recommended corrective actions.</p>
          </div>
        </li>
        <li class="deliver__item rv">
          {{ icon("proposal") }}
          <div>
            <h3 class="deliver__title">Security Policies and Procedures</h3>
            <p class="deliver__text">Documented security policies and procedures covering access management and data protection alongside incident handling and risk management based on your compliance requirements.</p>
          </div>
        </li>
        <li class="deliver__item rv">
          {{ icon("link") }}
          <div>
            <h3 class="deliver__title">Compliance Control Mapping</h3>
            <p class="deliver__text">A control mapping document linking applicable security requirements across frameworks such as ISO 27001 and SOC 2 alongside PCI DSS and other relevant standards to identify overlapping controls and documentation needs.</p>
          </div>
        </li>
        <li class="deliver__item rv">
          {{ icon("database") }}
          <div>
            <h3 class="deliver__title">Compliance Evidence Documentation</h3>
            <p class="deliver__text">Organized compliance records and supporting evidence for relevant security controls, helping teams maintain documentation for internal reviews and external audit preparation.</p>
          </div>
        </li>
        <li class="deliver__item rv">
          {{ icon("shield-check") }}
          <div>
            <h3 class="deliver__title">Remediation and Audit Readiness Report</h3>
            <p class="deliver__text">A summary of assessment findings and outstanding compliance gaps with prioritized remediation recommendations to help teams track corrective actions and prepare for compliance audits.</p>
          </div>
        </li>
      </ol>
    </div>
  </div>
</section>

