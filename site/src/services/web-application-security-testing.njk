<!-- PROCESS                                                              -->
<!-- ================================================================== -->
<section class="section section--ink" aria-labelledby="s5-title">
  <div class="container">
    <div class="process">
      <div class="process__aside">
        <h2 class="process__title" id="s5-title">Our Web App Security Testing Process</h2>
        <p class="process__lede">Our web app security testing process helps identify vulnerabilities, assess security risks and protect web applications from cyber threats. CipherTrivia combines automated tools with manual testing to deliver clear findings and practical security recommendations.</p>
      </div>

      <ol class="process__list" data-process>
        <li class="step">
          <span class="step__marker" aria-hidden="true"></span>
          <h3 class="step__title">Understanding Your Requirements</h3>
          <p class="step__text">We review your application, key features and security needs to define the testing scope and identify critical areas for assessment.</p>
        </li>
        <li class="step">
          <span class="step__marker" aria-hidden="true"></span>
          <h3 class="step__title">Identifying Security Weaknesses</h3>
          <p class="step__text">We examine your application to identify vulnerabilities, insecure settings and weaknesses that could expose sensitive data or allow unauthorized access.</p>
        </li>
        <li class="step">
          <span class="step__marker" aria-hidden="true"></span>
          <h3 class="step__title">Testing &amp; Validating Vulnerabilities</h3>
          <p class="step__text">Our web application penetration testing validates identified weaknesses through controlled testing to understand their potential impact.</p>
        </li>
        <li class="step">
          <span class="step__marker" aria-hidden="true"></span>
          <h3 class="step__title">Risk Assessment &amp; Prioritization</h3>
          <p class="step__text">We classify vulnerabilities by severity and business impact to help your team prioritize critical fixes.</p>
        </li>
        <li class="step">
          <span class="step__marker" aria-hidden="true"></span>
          <h3 class="step__title">Reporting &amp; Remediation Guidance</h3>
          <p class="step__text">We provide a web application security testing report with findings, potential impacts and practical steps to fix vulnerabilities.</p>
        </li>
        <li class="step">
          <span class="step__marker" aria-hidden="true"></span>
          <h3 class="step__title">Retesting &amp; Verification</h3>
          <p class="step__text">Where included in scope, we retest resolved issues to verify fixes and identify remaining vulnerabilities.</p>
        </li>
      </ol>
    </div>
  </div>
</section>

