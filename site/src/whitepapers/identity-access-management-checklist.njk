<section class="section section--white article" aria-label="Whitepaper content">
  <div class="container article__layout">
    <nav class="article__toc" aria-label="On this page" data-toc>
      <p class="article__toc-label">On this page</p>
      <ol>
          <li><a href="#joiner-mover-leaver">Joiner, Mover, Leaver</a></li>
          <li><a href="#what-we-find-in-cloud-iam-reviews">What We Find in Cloud IAM Reviews</a></li>
          <li><a href="#a-least-privilege-reference-model">A Least-Privilege Reference Model</a></li>
