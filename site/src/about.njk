<!-- 04 · OUR TEAM                                                        -->
<!-- ================================================================== -->
<section class="section section--paper" aria-labelledby="s4-title">
  <div class="container">
    <header class="shead">
      <div class="shead__meta">
        <p class="kicker kicker--label"><span class="kicker__slash">//</span> Our team</p>
      </div>
      <div class="shead__body">
        <h2 class="shead__title rv" id="s4-title">The People Behind the Reports</h2>
        <p class="shead__lede rv" style="--d:1">CipherTrivia is run by a small team of penetration testers, cloud security engineers and software architects from the Nextwebi engineering group. Team profiles are coming soon; in the meantime, every engagement is led directly by a senior security consultant.</p>
      </div>
    </header>

    <div class="rv">
      {{ ph("Team image", "2400 × 1000 · Penetration testers and cloud security engineers", "12 / 5") }}
    </div>

    <div class="svc-cta rv" style="margin-top:var(--s-6)">
      <div class="svc-cta__copy">
        <p class="svc-cta__text"><strong class="svc-cta__lead">Want to meet the team working on your assessment?</strong> We're happy to introduce the consultants on a scoping call.</p>
      </div>
      <a class="btn btn--signal" href="/contact/">Schedule a Meet {{ arrow() }}</a>
    </div>
  </div>
</section>

