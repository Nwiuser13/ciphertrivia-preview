<!-- HERO                                                                 -->
<!-- ================================================================== -->
<section class="hero" aria-labelledby="hero-title">
  <div class="guides" aria-hidden="true"><div class="container"></div></div>
  <div class="container">
    <div class="hero__layout">
      <div class="hero__copy">
        <p class="kicker kicker--label rv"><span class="kicker__slash">&lt;</span> Case Studies <span class="kicker__slash">&gt;</span></p>
        <h1 class="hero__title hero__title--long rv" style="--d:1" id="hero-title">Engineering Resilience Through Real-World Security Engagements</h1>
      </div>
      <div class="hero__visual hero__visual--sig rv" style="--d:2">
        {#- Engagement: a finding is fixed and re-tested, sector by sector -#}
        <div class="resolve" aria-hidden="true">
          <div class="resolve__pair">
            <div class="resolve__tile resolve__tile--found">{{ icon("shield-crack", "cover") }}</div>
            <div class="resolve__link">
              <span class="resolve__trace"></span>
              <span class="resolve__runner">{{ icon("wrench", "bare") }}</span>
            </div>
            <div class="resolve__tile resolve__tile--fixed">{{ icon("shield-check", "cover") }}</div>
          </div>
          <div class="resolve__sectors">
            {%- for s in ["card", "heart-pulse", "cloud-lock", "pipeline", "radar"] %}
            <span class="resolve__sector" style="--i:{{ loop.index0 }}">{{ icon(s, "sm") }}</span>
            {%- endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

