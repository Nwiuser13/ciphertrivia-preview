    Names and risks are the page's own terms; positions come from the grid in ai-security.css -#}
{%- set aimap = [
  ["prompt", "chat", "User Prompts", true, ["Prompt Injection"]],
  ["app", "browser", "AI Application", false, ["Broken Access Controls"]],
  ["llm", "sparkle", "LLM", true, ["Model Abuse and Manipulation", "Sensitive Data Exposure"]],
  ["agent", "agent", "AI Agent", true, ["Excessive AI Agent Permissions"]],
  ["tools", "api", "APIs and External Tools", false, ["Insecure API Integrations"]],
  ["docs", "document", "Enterprise Documents", false, ["Indirect Prompt Injection"]],
  ["rag", "database", "RAG Retrieval", true, ["RAG Data Exposure"]],
  ["systems", "network", "Connected Systems", false, ["Insecure Output Handling"]]
] %}
{%- set faqs = [
  ["Why is AI security testing important for businesses?", "AI security testing helps organizations identify vulnerabilities that could expose confidential information or compromise connected applications. It also helps assess risks associated with AI-generated outputs and automated agent actions before these systems are deployed or expanded."],
  ["What vulnerabilities can AI security testing identify?", "AI security testing can identify prompt injection and sensitive data leakage along with insecure output handling and broken access controls. AI agent assessments can also uncover excessive permissions and unauthorized tool execution or weaknesses in API integrations."],
  ["What is the difference between AI security testing and traditional application security testing?", "Traditional application security testing focuses on vulnerabilities such as injection flaws and broken authentication within conventional software. AI security testing also examines AI-specific risks involving prompts and model behavior along with retrieval mechanisms and agent interactions with external tools."],
  ["What is prompt injection in AI security?", "Prompt injection occurs when malicious instructions influence an AI system to disregard intended restrictions or process untrusted instructions in an unsafe way. It can lead to sensitive data exposure or unintended actions when the application lacks appropriate security controls."],
  ["Can AI security testing identify risks in autonomous AI agents?", "Yes. AI agent security testing can evaluate agent permissions and tool integrations along with access boundaries and safeguards against unauthorized actions. It can also assess how indirect prompt injection may affect agents that retrieve external content or interact with connected systems."],
  ["What is AI red teaming?", "AI red teaming uses controlled attack simulations to test the resilience of AI applications against malicious inputs and attempts to bypass security restrictions. It helps identify weaknesses in model behavior and application safeguards while providing evidence for remediation."],
  ["Can AI security services assess LLM and RAG applications?", "Yes. LLM and RAG security assessments can examine prompt handling and model responses along with retrieval permissions and access to connected documents. Testing helps identify weaknesses that could expose confidential information or allow unauthorized access to enterprise data."],
  ["What does an AI security assessment report include?", "An AI security assessment report typically includes identified vulnerabilities and their severity ratings along with supporting evidence and remediation recommendations. Depending on the agreed scope, it may also include attack scenarios and retesting results."],
  ["When should businesses conduct AI security testing?", "Businesses should consider AI security testing before deploying AI applications into production and after significant changes to models or integrations. Periodic assessments are also valuable when new AI agents or external tools are introduced."],
  ["How can CipherTrivia help improve AI application security?", "CipherTrivia helps organizations identify AI-specific vulnerabilities through structured security assessments and controlled testing. Its assessment approach covers relevant AI applications and agent workflows while providing risk-based findings and practical remediation guidance."]
] %}

