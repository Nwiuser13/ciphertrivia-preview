      <ul class="deliver__list">
        <li class="deliver__item rv">
          {{ icon("document") }}
          <div><p class="deliver__text"><strong>AI Security Assessment Report:</strong> A structured report covering the components assessed and the vulnerabilities identified during testing.</p></div>
        </li>
        <li class="deliver__item rv">
          {{ icon("magnifier") }}
          <div><p class="deliver__text"><strong>Vulnerability Details:</strong> Technical explanations of security weaknesses with supporting evidence where applicable.</p></div>
        </li>
        <li class="deliver__item rv">
          {{ icon("chart") }}
          <div><p class="deliver__text"><strong>Risk Severity Ratings:</strong> Prioritization of findings based on their potential impact and exploitability.</p></div>
        </li>
        <li class="deliver__item rv">
          {{ icon("route") }}
          <div><p class="deliver__text"><strong>Remediation Recommendations:</strong> Practical guidance to address identified weaknesses and improve security controls.</p></div>
        </li>
        <li class="deliver__item rv">
          {{ icon("lateral") }}
          <div><p class="deliver__text"><strong>AI Attack Scenario Findings:</strong> Results from relevant tests involving prompt injection and data exposure or unauthorized AI agent actions.</p></div>
        </li>
        <li class="deliver__item rv">
          {{ icon("retest") }}
          <div><p class="deliver__text"><strong>Retesting Results:</strong> Validation of implemented fixes when retesting is included in the engagement scope.</p></div>
        </li>
      </ul>
    </div>
  </div>
</section>

