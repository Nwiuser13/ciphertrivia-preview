    { url: "/services/penetration-testing/", icon: "lateral", name: "Penetration Testing", assets: "web mobile api cloud network",
      text: "Simulation of real-world cyberattacks to uncover exploitable weaknesses across applications, networks and infrastructure before attackers can target them.",
      tags: "Manual Testing · Exploit Validation · Risk Prioritization" },
    { url: "/services/web-application-security-testing/", icon: "browser", name: "Web Application Security Testing", assets: "web",
      text: "We detect security flaws in web applications through in-depth testing of authentication, authorization, business logic and data protection mechanisms.",
      tags: "OWASP Top 10 · Authentication Testing · Business Logic Testing" },
    { url: "/services/mobile-application-security-testing/", icon: "mobile", name: "Mobile Application Security Testing", assets: "mobile api",
      text: "We evaluate Android and iOS applications for vulnerabilities affecting data storage, authentication, API communication and runtime security.",
      tags: "Android Security · iOS Security · Mobile API Testing" }
  ] },
  { name: "Cloud & Infrastructure", services: [
    { url: "/services/cloud-security-services/", icon: "cloud-lock", name: "Cloud Security Services", assets: "cloud",
      text: "Assess AWS, Azure and GCP environments for configuration weaknesses, identity risks and infrastructure vulnerabilities that could expose business data.",
      tags: "Cloud Configuration · IAM Assessment · Infrastructure Security" },
    { url: "/services/api-security-testing/", icon: "api", name: "API Security Testing", assets: "api web mobile",
      text: "Identify API vulnerabilities involving broken access controls, authentication weaknesses, data exposure and insecure business logic.",
      tags: "API Authentication · Access Control · Data Exposure Testing" },
    { url: "/services/network-security-testing/", icon: "network", name: "Network Security Testing", assets: "network",
      text: "We evaluate network infrastructure and security controls to identify exposed services, weak configurations and potential attack paths.",
      tags: "Network Scanning · Firewall Assessment · Attack Surface Analysis" },
    { url: "/services/security-architecture-review/", icon: "flowchart", name: "Security Architecture Review", assets: "web api cloud network",
      text: "We review system architecture, trust boundaries and security controls to uncover design-level weaknesses and recommend practical improvements.",
      tags: "Threat Modeling · Architecture Assessment · Security Controls Review" },
    { url: "/services/iot-ot-security/", icon: "chip", name: "IoT & OT Security Testing", assets: "network",
      text: "Safely test connected devices, industrial control systems, smart infrastructure and robotics for weaknesses that could disrupt operations or open a way in.",
      tags: "Firmware Analysis · ICS and SCADA Assessment · IT/OT Segmentation" }
  ] },
  { name: "Managed & Advisory", services: [
    { url: "/services/cybersecurity-consulting/", icon: "proposal", name: "Cybersecurity Consulting", assets: "compliance",
      text: "We assess security risks and define effective security strategies through risk assessments, security architecture reviews and compliance guidance.",
      tags: "Security Strategy · Risk Assessment · Compliance Guidance" },
    { url: "/services/devsecops-services/", icon: "pipeline", name: "DevSecOps Services", assets: "pipeline web",
      text: "Integrate security testing into development workflows and CI/CD pipelines to detect vulnerabilities earlier and reduce application security risks.",
      tags: "SAST · DAST · Software Dependency Scanning" },
    { url: "/services/soc-as-a-service/", icon: "pulse", name: "SOC as a Service", assets: "monitoring",
      text: "Monitor security events and investigate suspicious activity through continuous threat detection, alert analysis and incident response support.",
      tags: "Threat Monitoring · Alert Triage · Incident Investigation" },
    { url: "/services/security-compliance/", icon: "doc-check", name: "Security Compliance Services", assets: "compliance",
      text: "We assess security controls and documentation against applicable standards and regulatory requirements to support audit preparation and compliance programs.",
      tags: "ISO 27001 · SOC 2 · Compliance Gap Assessment" },
    { url: "/services/post-quantum-cryptography-security/", icon: "quantum", name: "Post-Quantum Cryptography Security", assets: "network cloud api",
      text: "Find where your organization depends on quantum-vulnerable encryption, rank the risk and plan a phased migration to quantum-resistant cryptography.",
      tags: "Cryptographic Inventory · Quantum Risk Assessment · Migration Roadmap" }
  ] },
  { name: "AI Security", tag: "New", services: [
    { url: "/ai-security/", icon: "agent", name: "AI Security Services", assets: "ai api",
      text: "Protect AI applications and LLMs with AI security services from CipherTrivia. Identify AI vulnerabilities and reduce risks through security testing and expert guidance.",
      tags: "LLM Security Testing · AI Agent Testing · AI Red Teaming" },
    { url: "/services/llm-security-testing/", icon: "chat", name: "LLM Security Testing", assets: "ai api",
      text: "Test chatbots, copilots and generative AI applications for prompt injection, data leakage, unsafe outputs and tool misuse, with evidence-backed fixes.",
