{%- set allServices = [] %}
{%- for g in groups %}{% for s in g.services %}{% set _ = allServices.push(s) %}{% endfor %}{% endfor %}
{%- set filters = [["all", "All services"], ["web", "Web apps"], ["mobile", "Mobile apps"], ["api", "APIs"], ["cloud", "Cloud"], ["network", "Networks"], ["pipeline", "CI/CD pipelines"], ["ai", "AI systems"], ["monitoring", "24×7 monitoring"], ["compliance", "Compliance"]] %}
{%- set industries = [
  ["saas-technology", "Technology & SaaS", "saas-technology"],
  ["banking-fintech", "Fintech & Banking", "banking-industry"],
  ["healthcare", "Healthcare", "healthcare"],
  ["ecommerce", "Retail & Ecommerce", "ecommerce"],
  ["manufacturing", "Manufacturing", "manufacturing"],
  ["logistics", "Logistics", "logistics"],
  ["startups", "Startups", "startups"],
  ["enterprise-it", "Enterprise IT", "enterprise-it"]
] %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": "All Cybersecurity Services in One Place",
      "description": "Explore CipherTrivia's full cybersecurity service catalog: VAPT, penetration testing, web, mobile, API and cloud security, DevSecOps, SOC as a Service and compliance.",
      "url": "https://www.ciphertrivia.com/services/",
      "isPartOf": { "@type": "WebSite", "name": "CipherTrivia", "url": "https://www.ciphertrivia.com/" },
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": [
          {%- for s in allServices %}
          { "@type": "ListItem", "position": {{ loop.index }}, "name": {{ s.name | dump | safe }}, "url": "https://www.ciphertrivia.com{{ s.url }}" }{% if not loop.last %},{% endif %}
          {%- endfor %}
        ]
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.ciphertrivia.com/" },
        { "@type": "ListItem", "position": 2, "name": "Services" }
      ]
    }
  ]
}
</script>

<!-- ================================================================== -->
<!-- HERO                                                                 -->
<!-- ================================================================== -->
<section class="hero" aria-labelledby="hero-title">
  <div class="guides" aria-hidden="true"><div class="container"></div></div>
  <div class="container" style="position: relative">
    <header class="hub-head">
      <h1 class="hub-head__title rv" id="hero-title">All Cybersecurity Services in <span class="accent">One Place</span></h1>
      <p class="hub-head__lede rv" style="--d:1">At CipherTrivia, we help businesses uncover hidden security gaps and address emerging cyber threats through a risk-driven approach to digital protection. Our specialists evaluate applications, infrastructure and cloud environments to identify weaknesses before they can be exploited. By combining AI-assisted threat analysis with security assessments and industry-aligned compliance practices, we help organizations reduce exposure, improve incident preparedness and build a stronger foundation for secure digital operations.</p>
    </header>
  </div>
</section>

<!-- ================================================================== -->
<!-- FILTER: what are you securing? (sticky under the header)             -->
<!-- ================================================================== -->
<div class="filterbar" data-svc-filter>
  <div class="container filterbar__inner" role="group" aria-label="Filter services by what you are securing">
    <span class="filterbar__label" aria-hidden="true">What are you securing?</span>
    {%- for f in filters %}
    <button class="filter" type="button" data-asset="{{ f[0] }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ f[1] }}</button>
    {%- endfor %}
  </div>
</div>
<p class="sr-only" aria-live="polite" data-svc-status></p>

<!-- ================================================================== -->
<!-- CATALOGUE: groups from the header menu                               -->
<!-- ================================================================== -->
<section class="section section--white cat" aria-label="Service catalogue" data-svc-catalogue>
  <div class="container">
    {%- for g in groups %}
    <section class="cat-group" data-svc-group aria-labelledby="g{{ loop.index }}-title">
      <div class="cat-group__head">
        <h2 class="cat-group__title rv" id="g{{ loop.index }}-title">{{ g.name }}</h2>
        {%- if g.tag %}<span class="cat-group__tag">{{ g.tag }}</span>{% endif %}
      </div>
      <div class="cat-group__grid{% if g.services | length == 1 %} cat-group__grid--one{% endif %}">
        {%- for s in g.services %}
        <article class="cat-card{% if g.services | length == 1 %} cat-card--feature{% endif %} rv" style="--d:{{ loop.index0 % 2 }}" data-assets="{{ s.assets }}">
          <div class="cat-card__top">
            {{ icon(s.icon) }}
            {%- if g.services | length > 1 %}<span class="cat-card__go" aria-hidden="true">{{ arrow("") }}</span>{% endif %}
          </div>
          {%- if g.services | length == 1 %}<div>{% endif %}
          <h3 class="cat-card__title"><a class="cat-card__link" href="{{ s.url }}">{{ s.name }}</a></h3>
          <p class="cat-card__text">{{ s.text }}</p>
          <p class="cat-card__tags">{{ s.tags }}</p>
          {%- if g.services | length == 1 %}</div><span class="cat-card__go" aria-hidden="true">{{ arrow("") }}</span>{% endif %}
        </article>
        {%- endfor %}
      </div>
    </section>
    {%- endfor %}
  </div>
</section>

<!-- ================================================================== -->
<!-- INDUSTRIES + BACKED BY NEXTWEBI                                      -->
<!-- ================================================================== -->
<section class="section section--ink" aria-labelledby="ind-title">
  <div class="container">
    <header class="ihead">
      <h2 class="ihead__title rv" id="ind-title">Cybersecurity Services for Industries That Depend on Digital Trust</h2>
      <p class="ihead__lede rv" style="--d:1">Every industry faces different digital security challenges. From protecting customer information and financial transactions to securing business applications and connected systems, CipherTrivia helps organizations identify security gaps and reduce the risk of cyberattacks. Our cybersecurity services address industry-specific risks so businesses can protect their operations, maintain customer trust and support secure digital growth.</p>
    </header>

    <div class="tiles">
      {%- for i in industries %}
      <a class="tile rv" style="--d:{{ loop.index0 % 4 }}" href="/industries/{{ i[0] }}/">
        <img src="/assets/industries/{{ i[2] }}-960.webp" width="960" height="540" alt="" loading="lazy">
        <span class="tile__body">
          <span class="tile__name">{{ i[1] }}</span>
          <span class="tile__go" aria-hidden="true">{{ arrow("") }}</span>
        </span>
      </a>
      {%- endfor %}
    </div>

    {% include "partials/enterprise/backed.njk" %}
  </div>
</section>

<!-- ================================================================== -->
<!-- CTA BAND (the Security Risk Snapshot offer from the menu)            -->
<!-- ================================================================== -->
<section class="band" aria-labelledby="band-title">
  <div class="container band__inner">
    <p class="band__meta rv">Security Risk Snapshot</p>
    <h2 class="band__title rv" id="band-title">A free 30-minute review of your app, API and cloud exposure.</h2>
    <p class="band__text rv" style="--d:1">Leave with a prioritised action plan.</p>
    <div class="band__action rv" style="--d:2">
      <a class="btn btn--on-signal" href="/contact/">Book a session {{ arrow() }}</a>
    </div>
  </div>
</section>
