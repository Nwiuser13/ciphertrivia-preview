<section class="section section--ink" aria-labelledby="s2-title">
  <div class="container">
    <header class="ihead">
      <h2 class="ihead__title rv" id="s2-title">Cybersecurity Challenges Faced by Ecommerce Businesses</h2>
      <p class="ihead__lede rv" style="--d:1">Ecommerce businesses face security threats that can compromise customer accounts and payment information or disrupt online sales. CipherTrivia helps retailers identify these risks through targeted security assessments and actionable recommendations.</p>
    </header>

    <div class="surface" data-surface>
      <div class="surface__map" aria-hidden="true">
        <div class="surface__stage">
          <span class="surface__sweep"></span>
          <svg class="surface__lines" viewBox="0 0 400 400" focusable="false">
            <rect class="surface__frame" x="10" y="10" width="380" height="380"/>
            <rect class="surface__orbit" x="48" y="48" width="304" height="304"/>
            <rect class="surface__inner" x="124" y="124" width="152" height="152"/>
            <path class="surface__ticks" d="M200 0v20M200 380v20M0 200h20M380 200h20M0 10h20M10 0v20M380 10h20M390 0v20M0 390h20M10 380v20M380 390h20M390 380v20"/>
            {%- for c in challenges %}
            <line class="surface__spoke" data-surface-spoke x1="200" y1="200" x2="{{ c[3] }}" y2="{{ c[4] }}"/>
            {%- endfor %}
          </svg>
          <span class="surface__core">{{ icon("cart", "lg") }}</span>
          {%- for c in challenges %}
          <span class="surface__node" data-surface-node style="--x:{{ c[1] }};--y:{{ c[2] }}">{{ icon(c[0]) }}</span>
          {%- endfor %}
        </div>
      </div>

      <ul class="surface__list">
        {%- for c in challenges %}
        <li class="surface__item rv" data-surface-item>
          {{ icon(c[0], "sm") }}
          <div>
            <h3 class="surface__title">{{ c[5] }}</h3>
            <p class="surface__text">{{ c[6] }}</p>
          </div>
        </li>
        {%- endfor %}
      </ul>

      <div class="surface__close rv">
        <a class="btn btn--signal" href="/contact/">Talk to Our Security Experts {{ arrow() }}</a>
      </div>
    </div>
  </div>
</section>

