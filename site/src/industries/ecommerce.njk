<section class="ind-hero ind-hero--light ind-hero--band" aria-labelledby="hero-title">
  <div class="guides" aria-hidden="true"><div class="container"></div></div>

  <div class="container ind-hero__inner">
    <div class="ind-hero__copy">
      <h1 class="ind-hero__title rv" id="hero-title">Cybersecurity Services for <span class="accent">Retail &amp; Ecommerce</span> Industries</h1>
      <p class="ind-hero__lede rv" style="--d:1">Retailers and ecommerce businesses face growing security risks involving payment systems and customer data as well as online storefronts and interconnected retail infrastructure. CipherTrivia provides cybersecurity services for retail and ecommerce businesses through penetration testing and vulnerability assessments alongside application security testing and cloud security reviews. We help identify exploitable weaknesses and reduce security risks while protecting customer information and supporting secure digital transactions.</p>
      <div class="hero__actions rv" style="--d:2">
        <a class="btn btn--signal" href="/contact/">Talk to Our Security Experts {{ arrow() }}</a>
      </div>
    </div>
  </div>

  <div class="ind-hero__media">
    <img class="ind-hero__img" style="object-position: 45% 30%" src="/assets/industries/ecommerce.webp" srcset="/assets/industries/ecommerce-960.webp 960w, /assets/industries/ecommerce.webp 1920w" sizes="(max-width: 1100px) 100vw, 50vw" width="1920" height="1080" alt="Online seller working on a laptop beside packed orders and a clothing rail" fetchpriority="high">
    <div class="motif motif--rail" aria-hidden="true">
      <span class="motif-rail__track"></span><span class="motif-rail__fill"></span><span class="motif-rail__runner"></span>
      <span class="motif-rail__stop" style="--p:0%">{{ icon("cart", "sm") }}</span>
      <span class="motif-rail__stop" style="--p:33.3%">{{ icon("card", "sm") }}</span>
      <span class="motif-rail__stop" style="--p:66.6%">{{ icon("lock", "sm") }}</span>
      <span class="motif-rail__stop" style="--p:100%">{{ icon("shield-check", "sm") }}</span>
    </div>
  </div>
</section>

