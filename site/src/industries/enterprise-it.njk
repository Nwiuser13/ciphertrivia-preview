<!-- PROCESS: horizontal track that fills as the section is read          -->
<!-- ================================================================== -->
<section class="section section--white" aria-labelledby="s4-title">
  <div class="container">
    <header class="ihead">
      <h2 class="ihead__title rv" id="s4-title">Our Enterprise Cyber Security Assessment Process</h2>
      <p class="ihead__lede rv" style="--d:1">CipherTrivia follows a structured security assessment process to identify vulnerabilities and evaluate risks across enterprise applications and infrastructure. Each stage focuses on accurate findings and practical remediation guidance aligned with business priorities.</p>
    </header>

    <ol class="track" data-track>
      <li class="track__step rv">
        <span class="track__node" aria-hidden="true"></span>
        {{ icon("compass") }}
        <h3 class="track__title">Scope Definition and Asset Discovery</h3>
        <p class="track__text">We identify critical systems and business applications alongside network infrastructure and cloud assets to define the assessment scope and establish testing priorities.</p>
      </li>
      <li class="track__step rv" style="--d:1">
        <span class="track__node" aria-hidden="true"></span>
        {{ icon("radar") }}
        <h3 class="track__title">Security Testing and Vulnerability Discovery</h3>
        <p class="track__text">Our security specialists conduct penetration testing and vulnerability assessments to uncover exploitable weaknesses across enterprise environments and connected systems.</p>
      </li>
      <li class="track__step rv" style="--d:2">
        <span class="track__node" aria-hidden="true"></span>
        {{ icon("gauge") }}
        <h3 class="track__title">Risk Analysis and Validation</h3>
        <p class="track__text">Each finding is validated and evaluated based on severity and potential business impact, helping organizations distinguish critical exposures from lower-priority issues.</p>
      </li>
      <li class="track__step rv" style="--d:3">
        <span class="track__node" aria-hidden="true"></span>
        {{ icon("route") }}
        <h3 class="track__title">Reporting and Remediation Planning</h3>
        <p class="track__text">Receive a detailed security report outlining identified vulnerabilities and supporting evidence alongside risk ratings and prioritized recommendations for corrective action.</p>
      </li>
      <li class="track__step rv" style="--d:4">
        <span class="track__node" aria-hidden="true"></span>
        {{ icon("retest") }}
        <h3 class="track__title">Retesting and Security Improvement</h3>
        <p class="track__text">After remediation, we retest reported vulnerabilities to verify fixes and identify remaining gaps, giving enterprise teams a clearer view of their security posture.</p>
      </li>
    </ol>
  </div>
</section>

