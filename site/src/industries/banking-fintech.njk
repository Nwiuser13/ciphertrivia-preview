            <rect class="surface__orbit" x="48" y="48" width="304" height="304"/>
            <rect class="surface__inner" x="124" y="124" width="152" height="152"/>
            <path class="surface__ticks" d="M200 0v20M200 380v20M0 200h20M380 200h20M0 10h20M10 0v20M380 10h20M390 0v20M0 390h20M10 380v20M380 390h20M390 380v20"/>
            {%- for c in challenges %}
