<section class="section section--white" aria-labelledby="s6-title">
  <div class="container">
    <div class="faq-layout">
      <div class="faq-layout__aside">
        <h2 class="faq-layout__title" id="s6-title">Frequently Asked Questions About Fintech and Banking Cybersecurity</h2>
        <div class="contact-card">
          <div class="contact-card__row"><span>Email</span><a href="mailto:projects@ciphertrivia.com">projects@ciphertrivia.com</a></div>
          <div class="contact-card__row"><span>Phone</span><a href="tel:+919008372466">+91 90083 72466</a></div>
          <div class="contact-card__row"><span>Meet</span><a href="/contact/">Schedule a Meet</a></div>
        </div>
      </div>

      <div class="faq-layout__main">
        <div class="acc" data-acc>
          {%- for q in faqs %}
          <div class="acc__item">
            <h3 class="acc__h"><button class="acc__q" type="button" id="faq-q{{ loop.index }}" aria-expanded="false" aria-controls="faq-a{{ loop.index }}"><span class="acc__title">{{ q[0] }}</span><span class="acc__icon" aria-hidden="true"></span></button></h3>
            <div class="acc__a" id="faq-a{{ loop.index }}" aria-labelledby="faq-q{{ loop.index }}"><p>{{ q[1] }}</p></div>
          </div>
          {%- endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
