          <span class="surface__core">{{ icon("buildings", "lg") }}</span>
          {%- for c in challenges %}
          <span class="surface__node" data-surface-node style="--x:{{ c[1] }};--y:{{ c[2] }}">{{ icon(c[0]) }}</span>
          {%- endfor %}
        </div>
      </div>

      <ul class="surface__list">
        {%- for c in challenges %}
        <li class="surface__item rv" data-surface-item>
          {{ icon(c[0], "sm") }}
          <div>
            <h3 class="surface__title">{{ c[5] }}</h3>
            <p class="surface__text">{{ c[6] }}</p>
          </div>
        </li>
        {%- endfor %}
      </ul>

      <div class="surface__close rv">
        <p>CipherTrivia helps financial technology companies and banking institutions address these risks through Vulnerability Assessment and Penetration Testing (VAPT) and API penetration testing alongside application security testing and cloud security assessments. Our security testing identifies exploitable weaknesses and provides actionable remediation guidance to help reduce cyber risk across financial platforms.</p>
        <a class="btn btn--signal" href="/contact/">Talk to Our Security Experts {{ arrow() }}</a>
      </div>
    </div>
  </div>
</section>

