<section class="section section--ink" aria-labelledby="s3-title">
  <div class="container">
    <header class="ihead">
      <h2 class="ihead__title rv" id="s3-title">How Our Manufacturing Cybersecurity Engagement Works</h2>
      <p class="ihead__lede rv" style="--d:1">Every manufacturing environment has different security priorities depending on its production systems and network architecture or operational dependencies. CipherTrivia follows a structured assessment process that identifies exploitable weaknesses while accounting for the sensitivity of industrial systems and production requirements.</p>
    </header>

    <ol class="track" data-track>
      <li class="track__step rv">
        <span class="track__node" aria-hidden="true"></span>
        {{ icon("compass") }}
        <h3 class="track__title">Scope Definition and Asset Discovery</h3>
        <p class="track__text">We identify manufacturing applications and industrial networks alongside OT assets and critical infrastructure to define the assessment scope and testing priorities.</p>
      </li>
      <li class="track__step rv" style="--d:1">
        <span class="track__node" aria-hidden="true"></span>
        {{ icon("radar") }}
        <h3 class="track__title">Security Testing and Vulnerability Discovery</h3>
        <p class="track__text">Our team conducts penetration testing and vulnerability assessments to uncover weaknesses in network configurations and access controls or software and IT-OT connectivity.</p>
      </li>
      <li class="track__step rv" style="--d:2">
        <span class="track__node" aria-hidden="true"></span>
        {{ icon("gauge") }}
        <h3 class="track__title">Risk Validation and Impact Analysis</h3>
        <p class="track__text">We validate identified vulnerabilities and evaluate their potential impact on production availability and sensitive manufacturing data or connected industrial systems.</p>
      </li>
      <li class="track__step rv" style="--d:3">
        <span class="track__node" aria-hidden="true"></span>
        {{ icon("route") }}
        <h3 class="track__title">Reporting and Remediation Recommendations</h3>
        <p class="track__text">We deliver a detailed security report with validated findings and risk ratings alongside technical evidence and prioritized recommendations to help teams address critical weaknesses.</p>
      </li>
      <li class="track__step rv" style="--d:4">
        <span class="track__node" aria-hidden="true"></span>
        {{ icon("retest") }}
        <h3 class="track__title">Retesting and Security Verification</h3>
        <p class="track__text">Following remediation, we retest affected systems within the agreed scope to verify fixes and identify remaining vulnerabilities that may require further attention.</p>
      </li>
    </ol>

    <div class="track__cta rv">
      <a class="btn btn--signal" href="/contact/">Talk to Our Security Experts {{ arrow() }}</a>
    </div>
  </div>
</section>

