<section class="ind-hero ind-hero--angled" aria-labelledby="hero-title">
  <div class="guides" aria-hidden="true"><div class="container"></div></div>

  <div class="container ind-hero__inner">
    <div class="ind-hero__copy">
      <h1 class="ind-hero__title rv" id="hero-title">Cybersecurity Solutions for the <span class="accent">Logistics</span> Industry</h1>
      <p class="ind-hero__lede rv" style="--d:1">Keep shipments moving and supply chain operations secure with cybersecurity solutions for the logistics industry built to identify vulnerabilities across transportation systems and warehouse infrastructure. CipherTrivia helps logistics companies uncover security gaps in fleet management software and shipment tracking platforms or connected business applications through targeted security assessments and penetration testing. Request a security assessment to identify cyber risks and prioritize the fixes that help safeguard logistics data and maintain operational continuity.</p>
      <div class="hero__actions rv" style="--d:2">
        <a class="btn btn--signal" href="/contact/">Request a Security Assessment {{ arrow() }}</a>
      </div>
    </div>
  </div>

  <div class="ind-hero__media">
    <img class="ind-hero__img" style="object-position: 50% 50%" src="/assets/industries/logistics.webp" srcset="/assets/industries/logistics-960.webp 960w, /assets/industries/logistics.webp 1920w" sizes="(max-width: 1100px) 100vw, 50vw" width="1920" height="1080" alt="Freight truck on a motorway at sunset" fetchpriority="high">
    <svg class="motif motif--route" viewBox="0 0 600 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <path id="route-path" class="route" d="M170 650C250 600 250 500 330 455S500 330 520 150"/>
      <rect class="stop" x="163" y="643" width="14" height="14"/><rect class="stop" x="323" y="448" width="14" height="14"/><rect class="stop" x="513" y="143" width="14" height="14"/>
      <rect class="runner" x="-7" y="-7" width="14" height="14"><animateMotion dur="6s" repeatCount="indefinite"><mpath href="#route-path"/></animateMotion></rect>
    </svg>
  </div>
</section>

