<section class="section section--white" aria-labelledby="s4-title">
  <div class="container">
    <header class="ihead">
      <h2 class="ihead__title rv" id="s4-title">Our Startup Cybersecurity Assessment Process</h2>
      <p class="ihead__lede rv" style="--d:1">CipherTrivia follows a structured security testing process that helps startups identify vulnerabilities and prioritize fixes without losing sight of product development and business goals.</p>
    </header>

    <ol class="track" data-track>
      <li class="track__step rv">
        <span class="track__node" aria-hidden="true"></span>
        {{ icon("compass") }}
        <h3 class="track__title">Scope Definition and Security Planning</h3>
        <p class="track__text">We review your applications and APIs alongside cloud infrastructure and business requirements to define the assessment scope and identify critical assets.</p>
      </li>
      <li class="track__step rv" style="--d:1">
        <span class="track__node" aria-hidden="true"></span>
        {{ icon("radar") }}
        <h3 class="track__title">Vulnerability Discovery and Security Testing</h3>
        <p class="track__text">Our team conducts penetration testing and vulnerability assessments to uncover weaknesses in application logic and access controls or cloud configurations and exposed services.</p>
      </li>
      <li class="track__step rv" style="--d:2">
        <span class="track__node" aria-hidden="true"></span>
        {{ icon("gauge") }}
        <h3 class="track__title">Risk Analysis and Validation</h3>
        <p class="track__text">We validate identified vulnerabilities and assess their potential impact on customer data and product functionality or business operations.</p>
      </li>
      <li class="track__step rv" style="--d:3">
        <span class="track__node" aria-hidden="true"></span>
        {{ icon("route") }}
        <h3 class="track__title">Security Reporting and Remediation Guidance</h3>
        <p class="track__text">We deliver a detailed report with validated findings and risk ratings alongside practical recommendations to help your development team prioritize corrective actions.</p>
      </li>
      <li class="track__step rv" style="--d:4">
        <span class="track__node" aria-hidden="true"></span>
        {{ icon("retest") }}
        <h3 class="track__title">Retesting and Security Verification</h3>
        <p class="track__text">After fixes are implemented, we retest affected systems within the agreed scope to verify remediation and identify any remaining vulnerabilities.</p>
      </li>
    </ol>
  </div>
</section>

