<section class="ind-hero ind-hero--light ind-hero--lift" aria-labelledby="hero-title">
  <div class="guides" aria-hidden="true"><div class="container"></div></div>

  <div class="container ind-hero__inner">
    <div class="ind-hero__copy">
      <h1 class="ind-hero__title rv" id="hero-title">Cyber Security Solutions for <span class="accent">Startups</span></h1>
      <p class="ind-hero__lede rv" style="--d:1">CipherTrivia, a leading cyber security company, helps startups identify security gaps across applications and cloud infrastructure before they become costly business risks. We assess software products and APIs alongside digital assets to uncover vulnerabilities that could expose customer data or disrupt operations. Our cyber security services for startups deliver actionable security insights that help founders prioritize fixes and build customer confidence as their businesses grow.</p>
      <div class="hero__actions rv" style="--d:2">
        <a class="btn btn--signal" href="/contact/">Talk to Our Security Experts {{ arrow() }}</a>
      </div>
    </div>
  </div>

  <svg class="motif motif--launch" viewBox="0 0 1440 800" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path class="ghost" d="M-20 792C420 782 640 720 760 560S1050 120 1460 40"/><path d="M-20 792C420 782 640 720 760 560S1050 120 1460 40"/></svg>
