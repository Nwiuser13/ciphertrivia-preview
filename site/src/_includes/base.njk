<style>
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { font-family: Figtree, sans-serif; color:#0B1330; -webkit-font-smoothing: antialiased; overflow-x: hidden; width: 100%; }
  ::selection { background:#00D4FF; color:#07111F; }

  /* ---------- Grid pattern + atmosphere ---------- */
  .grid-pattern {
    background-image:
      linear-gradient(rgba(0,212,255,.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,212,255,.06) 1px, transparent 1px);
    background-size: 44px 44px;
  }
  .grid-pattern-light {
    background-image:
      linear-gradient(rgba(37,99,235,.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(37,99,235,.05) 1px, transparent 1px);
    background-size: 44px 44px;
  }
  .grid-deep {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 220%;
    height: 100%;
    background-image:
      linear-gradient(rgba(37,99,235,.32) 1.5px, transparent 1.5px),
      linear-gradient(90deg, rgba(37,99,235,.32) 1.5px, transparent 1.5px);
    background-size: 64px 64px;
    border-radius: 32px 32px 0 0;
    transform: translateX(-50%) perspective(450px) rotateX(72deg);
    transform-origin: bottom center;
    -webkit-mask-image: linear-gradient(to top, black 45%, transparent 95%);
    mask-image: linear-gradient(to top, black 45%, transparent 95%);
  }
  @media (prefers-reduced-motion: reduce) {
    .grid-deep { display: none; }
  }

  /* ---------- Testimonials carousel ---------- */
  #testiTrack { scrollbar-width:none; }
  #testiTrack::-webkit-scrollbar { display:none; }
  .hex-dot {
    width:12px; height:12px;
    clip-path: polygon(25% 6.7%, 75% 6.7%, 100% 50%, 75% 93.3%, 25% 93.3%, 0% 50%);
    background:#CBD5E1; transition: background .2s ease, transform .2s ease;
  }
  .hex-dot.active { background:#84CC16; transform:scale(1.25); }

  /* ---------- How it works — hexagon step icons ---------- */
  .hex-icon {
    width:6rem; height:6rem;
    clip-path: polygon(25% 6.7%, 75% 6.7%, 100% 50%, 75% 93.3%, 25% 93.3%, 0% 50%);
    background:#84CC16;
    display:flex; align-items:center; justify-content:center;
  }
  .step-figure {
    aspect-ratio: 4 / 3;
    display:flex; align-items:center; justify-content:center;
    background:
      linear-gradient(rgba(37,99,235,.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(37,99,235,.06) 1px, transparent 1px);
    background-size: 22px 22px;
    border:1px solid #E2E8F0; border-radius:1rem;
  }
  .hero-glow::before {
    content:''; position:absolute; inset:0; pointer-events:none;
    background:
      radial-gradient(700px 420px at 18% 22%, rgba(37,99,235,.28), transparent 60%),
      radial-gradient(640px 420px at 84% 30%, rgba(124,58,237,.22), transparent 60%),
      radial-gradient(800px 480px at 60% 110%, rgba(0,212,255,.14), transparent 60%);
  }

  /* ---------- Glass ---------- */
  .glass {
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.12);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  /* ---------- Image placeholders (real-image slots) ---------- */
  .img-ph {
    position:relative; overflow:hidden; display:flex; align-items:flex-end;
    background:
      linear-gradient(135deg, rgba(7,17,31,.92), rgba(22,36,60,.88)),
      radial-gradient(420px 260px at 75% 20%, rgba(0,212,255,.25), transparent 65%),
      radial-gradient(360px 240px at 15% 85%, rgba(124,58,237,.28), transparent 60%);
  }
  .img-ph::before {
    content:''; position:absolute; inset:0;
    background-image:
      linear-gradient(rgba(0,212,255,.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,212,255,.08) 1px, transparent 1px);
    background-size: 28px 28px;
  }
  .img-ph .ph-label {
    position:relative; z-index:1; width:100%;
    font-family:'JetBrains Mono',monospace; font-size:.68rem; line-height:1.4;
    color:rgba(226,240,255,.85); padding:.7rem .85rem;
    background:linear-gradient(transparent, rgba(7,17,31,.85));
    letter-spacing:.02em;
  }
  .img-ph .ph-label::before { content:'▣ IMAGE · '; color:#00D4FF; }

  /* ---------- Lightbox (figure image popups) ---------- */
  .lightbox-trigger { cursor: zoom-in; }
  #lightbox {
    position: fixed; inset: 0; z-index: 100; display: none;
    align-items: center; justify-content: center;
    background: rgba(7,17,31,.92); backdrop-filter: blur(6px);
    padding: 1.5rem;
  }
  #lightbox.open { display: flex; }
  #lightbox img {
    max-width: min(92vw, 1400px); max-height: 88vh;
    border-radius: 12px; box-shadow: 0 20px 60px rgba(0,0,0,.5);
    ring: 1px solid rgba(255,255,255,.1);
  }
  #lightbox .lightbox-close {
    position: absolute; top: 1.25rem; right: 1.5rem;
    width: 44px; height: 44px; border-radius: 999px;
    display: grid; place-items: center;
    background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.15);
    color: #fff; cursor: pointer; transition: background .2s ease;
  }
  #lightbox .lightbox-close:hover { background: rgba(255,255,255,.18); }

  /* ---------- Mega menu (full-width professional bar, Cloudflare-style) ---------- */
  .mega-panel {
    position:absolute; left:0; right:0; top:100%;
    visibility:hidden; opacity:0; transform: translateY(8px);
    transition: opacity .18s ease, transform .18s ease, visibility .18s;
    pointer-events:none; z-index:40;
  }
  /* Bridges the gap between the nav button and the panel so hover doesn't break while moving the mouse down */
  .mega-panel::before {
    content:''; position:absolute; top:-22px; left:0; right:0; height:22px;
    pointer-events:auto;
  }
  .mega-card { position:relative; }
  .mega-card::before { content:''; position:absolute; top:0; left:0; right:0; height:3px;
    background:linear-gradient(90deg,#00D4FF,#2563EB,#7C3AED); z-index:1; }
  .nav-item:hover > .mega-panel,
  .nav-item:focus-within > .mega-panel,
  .nav-item.open > .mega-panel {
    visibility:visible; opacity:1; transform: translateY(0); pointer-events:auto;
  }
  .mega-sheet {
    background:#fff;
    border-top:1px solid #E2E8F0;
    box-shadow: 0 30px 60px -20px rgba(2,8,20,.35), 0 12px 24px -12px rgba(2,8,20,.18);
  }
  .nav-item:hover > .nav-link, .nav-item:focus-within > .nav-link { color:#00D4FF; }
  .nav-item:hover > .nav-link .chev, .nav-item:focus-within > .nav-link .chev { transform: rotate(180deg); }
  .chev { transition: transform .18s ease; }
  .mega-link:hover .mega-title { color:#2563EB; }
  .mega-category { font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:.12em; color:#64748B; padding-bottom:.85rem; margin-bottom:1.1rem; border-bottom:1px solid #E2E8F0; }

  /* ---------- Header states ---------- */
  #siteHeader {
    background:rgba(7,17,31,.98);
    backdrop-filter:blur(10px);
    border-bottom:1px solid rgba(255,255,255,.08);
    transition: box-shadow .25s ease;
  }
  #siteHeader.solid { box-shadow:0 8px 24px rgba(0,0,0,.3); }

  /* ---------- Cards & hover ---------- */
  .lift { transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease; }
  .lift:hover { transform: translateY(-5px); box-shadow: 0 18px 40px -14px rgba(7,17,31,.18); }

  .res-card .img-ph { transition: transform .5s ease; }
  .res-card:hover .img-ph { transform: scale(1.06); }
  .svc-card:hover { border-color: rgba(132,204,22,.35); }
  .svc-icon { transition: background .3s ease, color .3s ease, clip-path .3s ease, border-radius .3s ease; }
  .svc-card:hover .svc-icon, .svc-card:focus-within .svc-icon {
    background: #84CC16;
    color: #07111F;
    border-radius: 0;
    clip-path: polygon(25% 6.7%, 75% 6.7%, 100% 50%, 75% 93.3%, 25% 93.3%, 0% 50%);
  }

  /* ---------- Corner marks (case studies) ---------- */
  .corner-mark { position:absolute; width:18px; height:18px; border-color:rgba(0,212,255,.35); pointer-events:none; z-index:2; }
  .corner-mark.tl { top:14px; left:14px; border-top:1px solid; border-left:1px solid; }
  .corner-mark.tr { top:14px; right:14px; border-top:1px solid; border-right:1px solid; }
  .corner-mark.bl { bottom:14px; left:14px; border-bottom:1px solid; border-left:1px solid; }
  .corner-mark.br { bottom:14px; right:14px; border-bottom:1px solid; border-right:1px solid; }

  /* ---------- Reveal on scroll ---------- */
  .reveal { opacity:0; transform: translateY(22px); transition: opacity .6s ease, transform .6s ease; }
  .reveal.in { opacity:1; transform:none; }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity:1; transform:none; transition:none; }
    .svc-card .svc-deep { transition:none; }
    html { scroll-behavior:auto; }
  }


  /* ---------- Timeline ---------- */
  .step-dot { box-shadow:0 0 0 6px rgba(37,99,235,.10); }

  /* ---------- Scrollbar (subtle) ---------- */
  .mega-panel ::-webkit-scrollbar { width:6px; }
  .mega-panel ::-webkit-scrollbar-thumb { background:#CBD5E1; border-radius:3px; }

  /* ---------- Hero video shade ---------- */
  .hero-shade { background: linear-gradient(180deg, rgba(7,17,31,.72) 0%, rgba(7,17,31,.55) 45%, rgba(7,17,31,.92) 100%); }

  /* ---------- Threat intel ticker ---------- */
  @keyframes tickerMove { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .ticker-track { animation: tickerMove 38s linear infinite; }
  .ticker-wrap:hover .ticker-track { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) { .ticker-track { animation:none; } }

  /* mobile accordion */
  .m-acc-body { display:grid; grid-template-rows:0fr; transition:grid-template-rows .28s ease; }
  .m-acc.open .m-acc-body { grid-template-rows:1fr; }
  .m-acc.open .m-chev { transform:rotate(180deg); }
  .m-chev { transition:transform .2s ease; }

  /* ---------- Hero security dashboard mockup ---------- */
  .dash {
    background: linear-gradient(180deg, rgba(13,24,42,.96), rgba(9,17,32,.98));
    border:1px solid rgba(148,163,184,.18);
    box-shadow: 0 40px 80px -24px rgba(0,0,0,.6), 0 0 0 1px rgba(0,212,255,.05), 0 0 60px -20px rgba(0,212,255,.25);
  }
  .dash-bar { transform-origin:left; transform:scaleX(0); transition: transform 1.1s cubic-bezier(.22,1,.36,1) .3s; }
  .reveal.in .dash-bar { transform:scaleX(1); }
  .gauge-arc { stroke-dasharray: 264; stroke-dashoffset: 264; transition: stroke-dashoffset 1.4s cubic-bezier(.22,1,.36,1) .25s; }
  .reveal.in .gauge-arc { stroke-dashoffset: 72; }
  @keyframes blinkDot { 0%,100%{opacity:1} 50%{opacity:.25} }
  .blink { animation: blinkDot 1.4s ease-in-out infinite; }
  @keyframes progressFill { 0%{width:8%} 60%{width:86%} 100%{width:94%} }
  .scan-progress { animation: progressFill 6s ease-in-out infinite alternate; }
  @media (prefers-reduced-motion: reduce) {
    .blink, .scan-progress { animation:none; }
    .gauge-arc { stroke-dashoffset:72; transition:none; }
    .dash-bar { transform:scaleX(1); transition:none; }
  }

  /* ---------- Agent Oversight Console (AI Security hero) ---------- */
  .agent-console { background: linear-gradient(180deg, rgba(13,24,42,.96), rgba(9,17,32,.98)); border:1px solid rgba(148,163,184,.18); box-shadow: 0 40px 80px -24px rgba(0,0,0,.6), 0 0 0 1px rgba(0,212,255,.05), 0 0 70px -20px rgba(124,58,237,.3); }
  @keyframes pulseRing { 0% { transform: scale(.9); opacity:.65; } 70%,100% { transform: scale(1.7); opacity:0; } }
  .pulse-ring { animation: pulseRing 3.2s cubic-bezier(.4,0,.6,1) infinite; transform-origin: center; transform-box: fill-box; }
  .pulse-ring.delay-1 { animation-delay: 1.05s; }
  .pulse-ring.delay-2 { animation-delay: 2.1s; }
  @keyframes nodeGlow { 0%,100% { filter: drop-shadow(0 0 3px currentColor); } 50% { filter: drop-shadow(0 0 12px currentColor); } }
  .node-glow { animation: nodeGlow 2.6s ease-in-out infinite; }
  @keyframes floatBadge { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  .float-badge { animation: floatBadge 4.5s ease-in-out infinite; }
  .float-badge.delay-1 { animation-delay: 1.4s; }
  .float-badge.delay-2 { animation-delay: 2.8s; }
  @keyframes spinSlow { to { transform: rotate(360deg); } }
  .spin-slow { animation: spinSlow 24s linear infinite; transform-origin: 220px 220px; }
  @media (prefers-reduced-motion: reduce) {
    .pulse-ring, .node-glow, .float-badge, .spin-slow, .agent-particle { animation: none; }
  }

  /* ---------- AI future section ---------- */
  .ai-glow { background: radial-gradient(700px 380px at 80% 10%, rgba(124,58,237,.22), transparent 60%), radial-gradient(620px 340px at 12% 90%, rgba(0,212,255,.16), transparent 60%); }
  .ai-card { background:rgba(255,255,255,.04); border:1px solid rgba(148,163,184,.15); backdrop-filter:blur(8px); transition: border-color .25s ease, transform .25s ease, background .25s ease; }
  .ai-card:hover { border-color:rgba(0,212,255,.45); transform:translateY(-4px); background:rgba(255,255,255,.06); }
</style>
