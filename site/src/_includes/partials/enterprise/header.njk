              </div>
              <div class="panel__col">
                <p class="panel__label">Apply</p>
                <a class="panel__link" href="/whitepapers/"><strong>Security Checklists</strong><span>Cloud and API assessment lists</span>{{ arrow() }}</a>
                <a class="panel__link" href="/case-studies/"><strong>Case Studies</strong><span>Real engagement outcomes</span>{{ arrow() }}</a>
              </div>
              <div class="panel__feature">
