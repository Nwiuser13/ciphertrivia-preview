                  <a class="panel__link" href="/industries/manufacturing/" {% if page.url == "/industries/manufacturing/" %}aria-current="page"{% endif %}><strong>Manufacturing</strong>{{ arrow() }}</a>
                  <a class="panel__link" href="/industries/logistics/" {% if page.url == "/industries/logistics/" %}aria-current="page"{% endif %}><strong>Logistics</strong>{{ arrow() }}</a>
                  <a class="panel__link" href="/industries/startups/" {% if page.url == "/industries/startups/" %}aria-current="page"{% endif %}><strong>Startups</strong>{{ arrow() }}</a>
                  <a class="panel__link" href="/industries/enterprise-it/" {% if page.url == "/industries/enterprise-it/" %}aria-current="page"{% endif %}><strong>Enterprise IT</strong>{{ arrow() }}</a>
                </div>
              </div>
