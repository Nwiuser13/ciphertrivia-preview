{% from "partials/enterprise/macros.njk" import arrow %}
<a class="skip-link" href="#main">Skip to content</a>

<div class="utilbar">
  <div class="container utilbar__inner">
    <a class="utilbar__alert" href="/contact/"><span><span class="utilbar__long">Experiencing a security incident? </span>Get emergency response</span></a>
    {#- Phones: call and quick inquiry in place of the alert -#}
    <a class="utilbar__call" href="tel:{{ enquiry.phone }}">Call now <strong>{{ enquiry.phoneDisplay }}</strong></a>
    <a class="utilbar__quote" href="{% if page.url == '/contact/' %}#get-started{% else %}/contact/#get-started{% endif %}"{% if page.url != '/contact/' %} data-qq-open{% endif %}>Quick inquiry</a>
    <div class="utilbar__meta">
      <a href="mailto:projects@ciphertrivia.com">projects@ciphertrivia.com</a>
      <a href="tel:+919008372466">+91 90083 72466</a>
      <span>Bengaluru, India</span>
    </div>
  </div>
</div>

<header class="hdr" data-hdr>
  <div class="container hdr__inner">
    <a class="brand" href="/">
      <img class="brand__logo" src="/assets/brand/ciphertrivia-logo-orange.png" alt="CipherTrivia" width="770" height="192">
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        <li class="nav__item">
          <button class="nav__link" type="button" aria-expanded="false" data-panel-trigger {% if navActive == "services" %}aria-current="true"{% endif %}>
            Services
            <svg class="nav__chev" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M1.5 3.5L5 7l3.5-3.5" stroke="currentColor" stroke-width="1.4"/></svg>
          </button>
          <div class="nav__panel">
            <div class="container panel__grid">
              <div class="panel__col">
                <p class="panel__label">Offensive Security</p>
                <a class="panel__link" href="/services/vapt-security-services/" {% if page.url == "/services/vapt-security-services/" %}aria-current="page"{% endif %}><strong>VAPT Security Services</strong><span>Assessment and exploit-driven testing</span>{{ arrow() }}</a>
                <a class="panel__link" href="/services/penetration-testing/" {% if page.url == "/services/penetration-testing/" %}aria-current="page"{% endif %}><strong>Penetration Testing</strong><span>Manual, attacker-simulated exploitation</span>{{ arrow() }}</a>
                <a class="panel__link" href="/services/web-application-security-testing/" {% if page.url == "/services/web-application-security-testing/" %}aria-current="page"{% endif %}><strong>Web App Security Testing</strong><span>OWASP Top 10, logic and auth flaws</span>{{ arrow() }}</a>
                <a class="panel__link" href="/services/mobile-application-security-testing/" {% if page.url == "/services/mobile-application-security-testing/" %}aria-current="page"{% endif %}><strong>Mobile App Security</strong><span>Android and iOS, OWASP MASVS</span>{{ arrow() }}</a>
              </div>
              <div class="panel__col">
                <p class="panel__label">Cloud &amp; Infrastructure</p>
                <a class="panel__link" href="/services/cloud-security-services/" {% if page.url == "/services/cloud-security-services/" %}aria-current="page"{% endif %}><strong>Cloud Security Services</strong><span>AWS, Azure and GCP configuration</span>{{ arrow() }}</a>
                <a class="panel__link" href="/services/api-security-testing/" {% if page.url == "/services/api-security-testing/" %}aria-current="page"{% endif %}><strong>API Security Testing</strong><span>REST and GraphQL, OWASP API Top 10</span>{{ arrow() }}</a>
                <a class="panel__link" href="/services/network-security-testing/" {% if page.url == "/services/network-security-testing/" %}aria-current="page"{% endif %}><strong>Network Security Testing</strong><span>External and internal exposure</span>{{ arrow() }}</a>
                <a class="panel__link" href="/services/security-architecture-review/" {% if page.url == "/services/security-architecture-review/" %}aria-current="page"{% endif %}><strong>Security Architecture Review</strong><span>Design-level threat modelling</span>{{ arrow() }}</a>
              </div>
              <div class="panel__col">
                <p class="panel__label">Managed &amp; Advisory</p>
                <a class="panel__link" href="/services/cybersecurity-consulting/" {% if page.url == "/services/cybersecurity-consulting/" %}aria-current="page"{% endif %}><strong>Cybersecurity Consulting</strong><span>Strategy, risk and roadmaps</span>{{ arrow() }}</a>
                <a class="panel__link" href="/services/devsecops-services/" {% if page.url == "/services/devsecops-services/" %}aria-current="page"{% endif %}><strong>DevSecOps Services</strong><span>Security inside CI/CD pipelines</span>{{ arrow() }}</a>
                <a class="panel__link" href="/services/soc-as-a-service/" {% if page.url == "/services/soc-as-a-service/" %}aria-current="page"{% endif %}><strong>SOC as a Service</strong><span>24×7 monitoring and response</span>{{ arrow() }}</a>
                <a class="panel__link" href="/services/security-compliance/" {% if page.url == "/services/security-compliance/" %}aria-current="page"{% endif %}><strong>Security Compliance</strong><span>ISO 27001, SOC 2, PCI DSS, HIPAA</span>{{ arrow() }}</a>
              </div>
              <div class="panel__feature">
                <p class="kicker">Security Risk Snapshot</p>
                <h3>A free 30-minute review of your app, API and cloud exposure.</h3>
                <p>Leave with a prioritised action plan.</p>
                <a class="btn btn--signal btn--sm" href="/contact/">Book a session {{ arrow() }}</a>
              </div>
            </div>
          </div>
        </li>

