                <a class="btn btn--signal btn--sm" href="/whitepapers/enterprise-vapt-guide/">Download {{ arrow() }}</a>
              </div>
            </div>
          </div>
        </li>

        <li class="nav__item"><a class="nav__link" href="/about/" {% if page.url == "/about/" %}aria-current="page"{% endif %}>About</a></li>
        <li class="nav__item"><a class="nav__link" href="/contact/" {% if page.url == "/contact/" %}aria-current="page"{% endif %}>Contact</a></li>
      </ul>
