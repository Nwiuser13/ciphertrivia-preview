          </div>
        </li>

        <li class="nav__item"><a class="nav__link" href="/ai-security/" {% if page.url == "/ai-security/" %}aria-current="page"{% endif %}>AI Security <span class="nav__tag">New</span></a></li>

        <li class="nav__item">
          <button class="nav__link" type="button" aria-expanded="false" data-panel-trigger {% if navActive == "resources" %}aria-current="true"{% endif %}>
            Resources
            <svg class="nav__chev" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M1.5 3.5L5 7l3.5-3.5" stroke="currentColor" stroke-width="1.4"/></svg>
          </button>
