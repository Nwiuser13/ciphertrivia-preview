      <nav class="ftr__col" aria-label="Industries">
        <h3><a href="/industries/">Industries</a></h3>
        <ul>
          <li><a href="/industries/saas-technology/">Technology &amp; SaaS</a></li>
          <li><a href="/industries/banking-fintech/">Fintech &amp; Banking</a></li>
          <li><a href="/industries/healthcare/">Healthcare</a></li>
          <li><a href="/industries/ecommerce/">Retail &amp; Ecommerce</a></li>
