{% from "partials/enterprise/macros.njk" import arrow %}
<footer class="ftr" aria-label="Footer">
  <div class="container">
    {%- if crumbs %}
    <nav class="ftr__trail" aria-label="Breadcrumb">
      <ol>
        {%- for c in crumbs %}
        <li>{% if c[1] and not loop.last %}<a href="{{ c[1] }}">{{ c[0] }}</a>{% else %}<span aria-current="page">{{ c[0] }}</span>{% endif %}</li>
        {%- endfor %}
      </ol>
    </nav>
    {%- endif %}
    <div class="ftr__top">
      <p class="ftr__statement">Find security weaknesses <span class="accent">before attackers do.</span></p>
      <div class="ftr__cta">
        <a class="btn btn--signal" href="/contact/">Schedule a Meet {{ arrow() }}</a>
        <a class="btn btn--ghost-inv" href="mailto:projects@ciphertrivia.com">Email us {{ arrow() }}</a>
      </div>
    </div>

    <div class="ftr__cols">
      <div class="ftr__about">
        <a class="brand" href="/">
          <img class="brand__logo brand__logo--lg" src="/assets/brand/ciphertrivia-logo-orange.png" alt="CipherTrivia" width="770" height="192" loading="lazy">
        </a>
        <p>Cybersecurity assessments covering application security, API testing, cloud protection and infrastructure vulnerabilities, combining AI-assisted analysis with expert guidance to help organizations identify risks and protect critical digital assets.</p>
        <address class="ftr__address">
          <a href="mailto:projects@ciphertrivia.com">projects@ciphertrivia.com</a><br>
          <a href="tel:+919008372466">+91 90083 72466</a>
        </address>
      </div>

      {#- Every service in two columns, then every industry, then company and resources.
          Privacy and terms sit in small type in the base row. A new service or industry page
          goes here as well as in the header menu and the hubs. -#}
      <nav class="ftr__col ftr__col--services" aria-label="Services">
        <h3><a href="/services/">Services</a></h3>
        <ul>
          <li><a href="/services/vapt-security-services/">VAPT Security Services</a></li>
          <li><a href="/services/penetration-testing/">Penetration Testing</a></li>
          <li><a href="/services/web-application-security-testing/">Web App Security Testing</a></li>
          <li><a href="/services/mobile-application-security-testing/">Mobile App Security Testing</a></li>
          <li><a href="/services/api-security-testing/">API Security Testing</a></li>
          <li><a href="/services/cloud-security-services/">Cloud Security Services</a></li>
