<section class="section section--paper" aria-labelledby="stack-title">
  <div class="container">
    <header class="shead">
      <div class="shead__meta"></div>
      <div class="shead__body">
        <h2 class="shead__title rv" id="stack-title">Emerging Security Services</h2>
        <p class="shead__lede rv" style="--d:1">AI systems, autonomous agents, encryption, digital identity and connected devices bring new ways to be attacked. CipherTrivia helps you find and fix those weaknesses before attackers do.</p>
      </div>
    </header>

    {%- set stackItems = [
      { title: "AI & LLM Security", icon: "chat", href: "/services/llm-security-testing/", text: "Protect AI chatbots, LLM applications, generative AI systems and AI agents.",
        more: "We test how your AI systems respond when someone tries to misuse them, and report what we find with evidence and practical fixes for your team.",
        points: [["Prompt injection testing", "Crafted inputs that override instructions or guardrails."], ["Data leakage", "Responses that expose private or training data."], ["Model security", "Access, abuse and tampering risks around the model."], ["AI red teaming", "Expert-led attacks on the whole AI application."]] },
      { title: "AI Agent Security", icon: "agent", href: "/services/ai-agent-security-testing/", text: "Protect autonomous AI agents, their tools, permissions, identities and connected systems.",
        more: "We review what an agent is allowed to do and how far a manipulated agent could go, then show where to tighten its limits.",
        points: [["Tools", "Which actions and APIs the agent can call."], ["Permissions", "Whether access stays limited to what the task needs."], ["Identities", "How the agent signs in and on whose behalf it acts."], ["Connected systems", "What it can reach if it is misled."]] },
      { title: "Post-Quantum Cryptography Security", icon: "quantum", href: "/services/post-quantum-cryptography-security/", text: "Help businesses assess encryption risks and plan migration to quantum-resistant cryptography.",
        more: "We map where your systems rely on encryption that quantum computers could one day break, and help you plan a practical order of migration.",
        points: [["Encryption risks", "Where vulnerable algorithms and keys are in use."], ["Migration planning", "A phased path with priorities and dependencies."], ["Quantum-resistant cryptography", "Which standards fit your systems."]] },
      { title: "Digital Identity & Deepfake Security", icon: "user-shield", href: "/services/digital-identity-deepfake-security/", text: "Protect organisations from identity impersonation, synthetic identities and deepfake-enabled fraud.",
        more: "We assess how attackers could pose as your people or customers, and how well your checks hold up against synthetic voices, faces and documents.",
        points: [["Identity impersonation", "Account takeover and caller or email spoofing."], ["Synthetic identities", "Fake profiles that pass onboarding checks."], ["Deepfake-enabled fraud", "Cloned voice or video used to approve payments."]] },
      { title: "IoT & OT Security", icon: "chip", href: "/services/iot-ot-security/", text: "Protect connected devices, industrial systems, smart infrastructure and robotics.",
        more: "We examine devices and industrial systems where they meet your network, looking for weaknesses that could disrupt operations or open a way in.",
        points: [["Connected devices", "Default credentials, firmware and exposed services."], ["Industrial systems", "Control networks and their links to IT."], ["Smart infrastructure", "Building and facility systems on the network."], ["Robotics", "Control interfaces and update channels."]] }
    ] -%}
    <ol class="stack" data-stack>
      {%- for s in stackItems %}
      <li class="stack__card" style="--i:{{ loop.index0 }}" data-stack-card>
        <div class="stack__body">
          <h3 class="stack__title">{{ s.title }}</h3>
          <p class="stack__text">{{ s.text }}</p>
          <p class="stack__more">{{ s.more }}</p>
          <ul class="stack__points">
            {%- for p in s.points %}
            <li class="stack__point" data-stack-tag data-label="{{ p[0] }}"><strong>{{ p[0] }}</strong><span>{{ p[1] }}</span></li>
            {%- endfor %}
          </ul>
          <a class="btn btn--signal stack__cta" href="{{ s.href }}">View details {{ arrow() }}</a>
        </div>
        <div class="stack__visual" aria-hidden="true" data-stack-visual>
          <div class="stack__tilt">{{ icon(s.icon, "xl") }}</div>
          <p class="stack__read" data-stack-read>Focus areas</p>
        </div>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

