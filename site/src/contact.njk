      },
      "@id": "https://www.ciphertrivia.com/contact/#webpage",
      "isPartOf": {
        "@id": "https://www.ciphertrivia.com/#website"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.ciphertrivia.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Contact"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How quickly can an assessment start?",
          "acceptedAnswer": {
