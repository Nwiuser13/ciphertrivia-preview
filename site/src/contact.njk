<section class="final" aria-labelledby="final-title">
  <div class="guides" aria-hidden="true" style="opacity:.35"><div class="container" style="--line: rgba(255,255,255,.08)"></div></div>
  <div class="container final__inner">
    <h2 class="final__title rv" id="final-title">Not sure where <span class="accent">to start?</span></h2>
    <div class="final__body">
      <p class="final__text rv" style="--d:1">Book a free 30-minute Security Risk Snapshot and we'll point you in the right direction.</p>
      <div class="final__actions rv" style="--d:2">
        <a class="btn btn--signal btn--up" href="#get-started">Send a Message {{ arrow() }}</a>
      </div>
    </div>
    <div class="final__media rv" style="--d:3">
      <div class="cover cover--signal" aria-hidden="true">{{ icon("gauge", "cover") }}</div>
