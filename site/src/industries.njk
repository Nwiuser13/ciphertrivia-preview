<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": "Industries We Secure",
      "description": "CipherTrivia secures SaaS, fintech, healthcare, ecommerce, manufacturing, logistics, startups and enterprise IT against modern cyber threats.",
      "url": "https://www.ciphertrivia.com/industries/",
      "isPartOf": { "@type": "WebSite", "name": "CipherTrivia", "url": "https://www.ciphertrivia.com/" },
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": [
          {%- for i in industries %}
          { "@type": "ListItem", "position": {{ loop.index }}, "name": {{ i.name | dump | safe }}, "url": "https://www.ciphertrivia.com/industries/{{ i.slug }}/" }{% if not loop.last %},{% endif %}
          {%- endfor %}
        ]
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.ciphertrivia.com/" },
        { "@type": "ListItem", "position": 2, "name": "Industries" }
      ]
    }
  ]
}
</script>

<!-- ================================================================== -->
<!-- HERO + INDEX: the list on the left, the industry's own photo wipes  -->
<!-- into the sticky frame as each row becomes active                     -->
<!-- ================================================================== -->
<section class="hub-ink" aria-labelledby="hero-title">
  <div class="guides" aria-hidden="true"><div class="container"></div></div>

  <div class="container" style="position: relative">
    <header class="hub-head">
      <h1 class="hub-head__title rv" id="hero-title">Cybersecurity for <span class="accent">High-Risk</span> and Fast-Growing Industries</h1>
      <p class="hub-head__lede rv" style="--d:1">Compliance-heavy and fast-scaling industries are our core focus. Each industry page explains the specific security challenges, the services we deliver, and the compliance frameworks that apply to your sector.</p>
    </header>

    <header class="ihead">
      <h2 class="ihead__title rv" id="index-title">Industries We Secure</h2>
      <p class="ihead__lede rv" style="--d:1">Every industry faces different digital security challenges. From protecting customer information and financial transactions to securing business applications and connected systems, CipherTrivia helps organizations identify security gaps and reduce the risk of cyberattacks. Our cybersecurity services address industry-specific risks so businesses can protect their operations, maintain customer trust and support secure digital growth.</p>
    </header>

    <div class="xind" data-explorer>
      <ul class="xind__list" aria-labelledby="index-title">
        {%- for i in industries %}
        <li class="xind__item{% if loop.first %} is-active{% endif %}" data-explorer-item>
          <a class="xind__link" href="/industries/{{ i.slug }}/">
            <img class="xind__thumb" src="/assets/industries/{{ i.img }}-960.webp" width="960" height="540" alt="" loading="lazy">
            <h3 class="xind__name">{{ i.name }}</h3>
            <span class="xind__go" aria-hidden="true">{{ arrow("") }}</span>
            <p class="xind__text">{{ i.text }}</p>
            <p class="xind__tags">{{ i.tags }}</p>
          </a>
        </li>
        {%- endfor %}
      </ul>

      <div class="xind__stage" aria-hidden="true">
        <div class="xind__frames">
          {%- for i in industries %}
          <figure class="xind__frame{% if loop.first %} is-active{% endif %}" data-explorer-media>
            <img src="/assets/industries/{{ i.img }}-960.webp" width="960" height="540" alt="" {% if not loop.first %}loading="lazy"{% endif %}>
          </figure>
          {%- endfor %}
          <span class="ind-hero__frame"><i></i><i></i><i></i><i></i></span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================================================================== -->
<!-- FRAMEWORK MATRIX: what each industry page covers, side by side       -->
<!-- ================================================================== -->
<section class="section section--white" aria-labelledby="mx-title">
  <div class="container">
    <header class="ihead">
      <h2 class="ihead__title rv" id="mx-title">Compliance Frameworks Across the Industries We Secure</h2>
      <p class="ihead__lede rv" style="--d:1">Each industry page maps our security testing to the frameworks that apply to that sector. This view puts them side by side, so you can see the common ground and the sector-specific requirements at a glance.</p>
    </header>

    <div class="mx-wrap rv">
      <table class="mx">
        <caption class="sr-only">Compliance frameworks addressed on each industry page</caption>
        <thead>
          <tr>
            <th scope="col">Industry</th>
            {%- for f in frameworks %}
            <th scope="col">{{ f }}</th>
            {%- endfor %}
            <th scope="col">Sector-specific</th>
          </tr>
        </thead>
        <tbody>
          {%- for i in industries %}
          {%- set row = loop.index0 %}
          <tr>
            <th scope="row"><a href="/industries/{{ i.slug }}/">{{ i.name }}</a></th>
            {%- for on in i.mx %}
            {%- if on %}
            <td class="is-on" data-label="{{ frameworks[loop.index0] }}" style="--c:{{ loop.index0 }};--r:{{ row }}"><span class="mx__dot" aria-hidden="true"></span><span class="sr-only">Covered</span></td>
            {%- else %}
            <td><span class="mx__dot" aria-hidden="true"></span><span class="sr-only">Not listed</span></td>
            {%- endif %}
            {%- endfor %}
            <td class="mx__more">{{ i.more }}</td>
          </tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>
    <p class="mx-note rv">Applicability depends on each organization's operations and regulatory obligations. Our assessments support compliance readiness but do not replace independent audits or formal certification.</p>
  </div>
</section>

